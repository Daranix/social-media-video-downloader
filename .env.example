# Cache & temporary storage
CACHE_TTL_SECONDS=3600
CACHE_CLEANUP_INTERVAL=300
TEMP_DIR=

# Optional Netscape-format cookies.txt path (copied per request to an isolated temp file)
COOKIES_FILE=

# Optional HTTP/HTTPS/SOCKS proxy URL (e.g., http://user:pass@host:port or socks5://127.0.0.1:1080)
PROXY_URL=

# Optional browser impersonation override:
# - auto (default): impersonate for Instagram URLs only; YouTube uses its configured player_client
# - off: disable explicit ydl_opts impersonation
# - <target>: explicit yt-dlp impersonate target for non-YouTube URLs (e.g., chrome, chrome:windows-10, safari)
YTDLP_IMPERSONATE=auto

# Optional non-negative delay in seconds between extractor HTTP requests
YTDLP_SLEEP_REQUESTS=0.5

# Optional non-negative number of retries for known extractor errors
YTDLP_EXTRACTOR_RETRIES=3

# Maximum concurrent yt-dlp operations executed in the thread pool
YTDLP_MAX_CONCURRENT_JOBS=4
